<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Mac App Store edition: sandboxed, no network (updates come from the App Store). -->
    <key>com.apple.security.app-sandbox</key><true/>
    <!-- Microphone / line-in, and audio from other apps via Core Audio process taps. -->
    <key>com.apple.security.device.audio-input</key><true/>
    <!-- Reading the logo the user picks, and saving recordings to a folder they choose. -->
    <key>com.apple.security.files.user-selected.read-write</key><true/>
    <key>com.apple.security.files.bookmarks.app-scope</key><true/>
    <!-- Recordings are saved to Movies by default. -->
    <key>com.apple.security.assets.movies.read-write</key><true/>
    <!-- Phone remote: a small web server on the local network (off until the user turns it on). -->
    <key>com.apple.security.network.server</key><true/>
    <key>com.apple.application-identifier</key><string>FZAS899962.io.github.allenrobberson.dropocalypse</string>
    <key>com.apple.developer.team-identifier</key><string>FZAS899962</string>
</dict>
</plist>
